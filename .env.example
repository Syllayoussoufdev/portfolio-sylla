# ========================================================
# NEON POSTGRESQL (Récupéré depuis la console Neon)
# ========================================================
# 1. Connexion Neon poolée avec "-pooler" (utilisée par l'application Next.js au runtime)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# 2. Connexion Neon directe/unpooled sans "-pooler" (utilisée par Prisma CLI pour migrations et db push)
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ========================================================
# AUTHENTIFICATION ADMINISTRATEUR
# ========================================================
ADMIN_EMAIL="contact@syllayoussouf.com"
# Hash bcrypt du mot de passe admin (généré avec bcrypt.hashSync)
ADMIN_PASSWORD_HASH=""
# Mot de passe brut (uniquement pour développement local rapide si hash non fourni)
ADMIN_PASSWORD=""
# Secret JWT pour signer la session (au moins 32 caractères)
AUTH_SECRET="change_me_to_a_secure_random_string_at_least_32_chars"

# ========================================================
# CLOUDINARY (Upload direct d'images - Étape 1 Phase 2bis)
# ========================================================
# Nom de votre cloud Cloudinary (ex: "sylla-portfolio")
CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Clé d'API publique Cloudinary (ex: "123456789012345")
CLOUDINARY_API_KEY="your-api-key"
# Secret d'API Cloudinary - RESTE STRICTEMENT SERVEUR (NE JAMAIS PRÉFIXER PAR NEXT_PUBLIC_)
CLOUDINARY_API_SECRET="your-api-secret"
