// Prisma schema file for Portfolio Sylla
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// 1. Projets
// ----------------------------------------------------
model Project {
  id          String                @id @default(cuid())
  titre       String
  slug        String                @unique
  description String                @db.Text
  contenu     String?               @db.Text
  coverImage  String?
  links       Json                  @default("{}")
  tags        String[]
  ordre       Int                   @default(0)
  visible     Boolean               @default(true)
  featured    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  coverMediaId String?
  coverMedia   Media?                @relation("ProjectCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  mediaGallery ProjectMedia[]

  subPortfolios SubPortfolioProject[]
  visits        Visit[]

  @@index([slug])
  @@index([visible])
  @@index([coverMediaId])
}

// ----------------------------------------------------
// 2. Sous-Portfolios ciblés (/[profil])
// ----------------------------------------------------
model SubPortfolio {
  id          String                @id @default(cuid())
  slug        String                @unique
  label       String
  description String?               @db.Text
  actif       Boolean               @default(true)
  createdAt   DateTime              @default(now())

  projects    SubPortfolioProject[]
  skills      SubPortfolioSkillCategory[]
  visits      Visit[]
  profile     Profile?

  @@index([slug])
}

// ----------------------------------------------------
// 3. Table de jointure plusieurs-à-plusieurs (SubPortfolio <-> Project)
// ----------------------------------------------------
model SubPortfolioProject {
  subPortfolioId String
  projectId      String
  ordre          Int          @default(0)

  subPortfolio   SubPortfolio @relation(fields: [subPortfolioId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([subPortfolioId, projectId])
  @@index([subPortfolioId])
  @@index([projectId])
}

// ----------------------------------------------------
// 4. Analytics et Visites
// Note : l'IP ne doit jamais être enregistrée en clair (hash anonymisé SHA-256)
// ----------------------------------------------------
model Visit {
  id             String        @id @default(cuid())
  path           String
  projectId      String?
  subPortfolioId String?
  ip             String?
  userAgent      String?       @db.Text
  createdAt      DateTime      @default(now())

  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subPortfolio   SubPortfolio? @relation(fields: [subPortfolioId], references: [id], onDelete: SetNull)

  @@index([path])
  @@index([projectId])
  @@index([subPortfolioId])
  @@index([createdAt])
}

// ----------------------------------------------------
// 5. Messages de contact reçus
// ----------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  email     String
  message   String   @db.Text
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// 6. Médiathèque Cloudinary (Étape 1 de Phase 2bis)
// ----------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  width     Int
  height    Int
  format    String
  bytes     Int
  alt       String
  createdAt DateTime @default(now())

  coverForProjects Project[]      @relation("ProjectCoverMedia")
  projectGalleries ProjectMedia[]
  heroForProfiles  Profile[]      @relation("ProfileHeroMedia")

  @@index([publicId])
  @@index([createdAt])
}

model ProjectMedia {
  projectId String
  mediaId   String
  position  Int     @default(0)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaId])
  @@index([projectId])
  @@index([mediaId])
  @@index([position])
}

// ----------------------------------------------------
// 7. Profils & Configuration des Templates (Étape 2)
// ----------------------------------------------------
model Profile {
  id             String        @id @default(cuid())
  slug           String        @unique               // "default" pour la racine /, ou slug ciblé (ex: "creatif")
  label          String                              // Nom affiché dans le dashboard (ex: "Profil Principal")
  template       String        @default("creatif")   // creatif | developpeur | immersif
  accent         String        @default("default")   // variante de palette prévalidée
  hero           Json                                // Structuré et validé par Zod
  sections       Json                                // Ordre et visibilité : [{ key, visible, order }]
  variables      Json?         @default("{}")        // Variables additionnelles
  seoTitle       String?
  seoDescription String?       @db.Text
  heroMediaId    String?
  heroMedia      Media?        @relation("ProfileHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  isDefault      Boolean       @default(false)       // true pour le profil chargé sur "/"
  actif          Boolean       @default(true)        // convention existante (SubPortfolio.actif)
  subPortfolioId String?       @unique               // liaison 1-to-1 optionnelle avec un sous-portfolio
  subPortfolio   SubPortfolio? @relation(fields: [subPortfolioId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug])
  @@index([isDefault])
  @@index([actif])
  @@index([heroMediaId])
}

// ----------------------------------------------------
// 8. Réglages globaux du site (Singleton)
// ----------------------------------------------------
model SiteSettings {
  id          String   @id @default(cuid())
  nom         String   @default("Sylla Youssouf")
  metier      String?                           // Ligne de métier sous le logo
  emailPublic String?                           // Optionnel (rien n'est affiché si non renseigné)
  whatsapp    String?                           // Optionnel
  github      String?
  linkedin    String?
  twitter     String?
  instagram   String?
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// 9. Compétences & Outils par Grandes Familles (CRUD & Groupage)
// ----------------------------------------------------
enum SkillType {
  COMPETENCE // Savoir-faire / Expertise technique (ex: Architecture API, Responsive Design)
  OUTIL      // Logiciel / Framework / Outil de production (ex: Next.js, Figma, Premiere Pro)
}

model SkillCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  titre       String
  description String?  @db.Text
  icon        String   @default("Code") // Nom d'icône Lucide (Code, Palette, Film, Server, Smartphone, Terminal, etc.)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills        Skill[]
  subPortfolios SubPortfolioSkillCategory[]

  @@index([slug])
  @@index([ordre])
}

model Skill {
  id          String    @id @default(cuid())
  nom         String
  type        SkillType @default(COMPETENCE) // Séparation claire : COMPETENCE vs OUTIL
  niveau      String?   // "Avancé", "Expert", "Maîtrisé", "Production", etc.
  pourcentage Int?      // Niveau de maîtrise chiffré (0-100) pour affichage adaptatif
  icon        String?   // Identifiant de logo / icône optionnel
  categoryId  String
  ordre       Int       @default(0)
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([type])
  @@index([ordre])
}

model SubPortfolioSkillCategory {
  subPortfolioId String
  categoryId     String
  ordre          Int      @default(0)

  subPortfolio SubPortfolio  @relation(fields: [subPortfolioId], references: [id], onDelete: Cascade)
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([subPortfolioId, categoryId])
  @@index([subPortfolioId])
  @@index([categoryId])
}

